## Containers
API_URL=http://localhost:8000
REDIS_URL=redis://redis:6379
SERVER_NAME=localhost
GAME_MERCURE_PORT=8081
MERCURE_CORS_ORIGINS=http://localhost:3000

# Default hub lives in the php/FrankenPHP container, over plain HTTP internally
MERCURE_URL=http://php/.well-known/mercure
# Game hub: dedicated port, no TLS, for clients that can't do SSL
GAME_MERCURE_URL=http://php:${GAME_MERCURE_PORT}/.well-known/mercure

## Publics
# Browsers use HTTPS for the default hub (self-signed cert in dev)
MERCURE_PUBLIC_URL=https://localhost:8443/.well-known/mercure
GAME_MERCURE_PUBLIC_URL=http://localhost:${GAME_MERCURE_PORT}/.well-known/mercure

## Mercure
MERCURE_PUBLISHER_SECRET=!ChangeThisMercureHubJWTSecretKey!
MERCURE_SUBSCRIBER_SECRET=!ChangeThisMercureHubJWTSecretKey!
GAME_MERCURE_PUBLISHER_SECRET=${MERCURE_PUBLISHER_SECRET}
GAME_MERCURE_SUBSCRIBER_SECRET=${MERCURE_SUBSCRIBER_SECRET}
